{% comment %}
  Placement-only anchor for FPB product-page upsells. The app embed owns data,
  rendering, behavior, and presentation.
{% endcomment %}
<div {{ block.shopify_attributes }} data-wpb-fpb-upsell-anchor></div>

{% schema %}
{
  "name": "t:theme_resources.full_page_upsell.name",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:theme_resources.full_page_upsell.description"
    }
  ]
}
{% endschema %}
