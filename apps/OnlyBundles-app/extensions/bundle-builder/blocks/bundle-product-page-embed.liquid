{% comment %}
  Custom placement anchor for Product Page Bundle embeds. The global app embed
  owns eligibility, assets, and rendering.
{% endcomment %}

<div
  {{ block.shopify_attributes }}
  data-wpb-ppb-embed-anchor
></div>

{% schema %}
{
  "name": "t:theme_resources.product_page_placement.name",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:theme_resources.product_page_placement.description"
    }
  ]
}
{% endschema %}
